{
  "manifest_version": 3,
  "name": "URL Logger",
  "version": "1.0",
  "permissions": ["tabs", "scripting", "storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",  
    "default_title": "URL Logger"
  }
}
